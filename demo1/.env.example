# ---------------------------------------------------------------------------
# Optional LLM tactical advisor
# The game runs perfectly without this. When unset, the backend returns a
# deterministic local tip and the UI labels it "LOCAL".
#
# Any OpenAI-compatible chat-completions endpoint works.
# The server appends /chat/completions unless LLM_BASE_URL already ends with it.
#
# DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
# Qwen / DashScope compatible mode:
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
#
# Ollama / vLLM locally (API key can stay empty):
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=llama3.2
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=9000
